# Set to true during development to point at MODEL_PROTOTYPE instead of MODEL.
DEV=false

# OpenRouter API key (https://openrouter.ai) -- sign up, then create a key at
# https://openrouter.ai/settings/keys. Free tier: 50 requests/day for ":free"-tagged
# models, bumped to 1000/day once you've purchased $10+ in lifetime credit (the free
# models themselves stay $0 either way).
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Primary model. NOTE: OpenRouter's own "openrouter/free" auto-router was tried and
# rejected -- it can route a request to a non-chat model (observed: a content-safety
# classifier that refused the whole task seeing jockey/trainer names as "PII"). The default
# below was verified live to produce correctly-formatted output. The free roster rotates
# roughly weekly, so if this model disappears, check https://openrouter.ai/models?max_price=0
# (or GET /api/v1/models) for a current general-purpose ":free" chat model to replace it.
MODEL=z-ai/glm-5.2:free

# Fallback model, tried once if the primary is rate-limited and a same-model retry also
# fails. Pick a different provider/lab than MODEL so a provider-wide outage doesn't take
# out both.
MODEL_UPGRADE=google/gemma-4-31b-it:free

# Optional model used instead of MODEL when DEV=true.
MODEL_PROTOTYPE=z-ai/glm-5.2:free

# Optional attribution headers OpenRouter shows on its public leaderboards -- cosmetic
# only, requests work fine with these unset.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=Hoof Hearted

# Optional shared secret gating the LLM-spending endpoints (POST /analyze and
# /analyze/{track_id}/{race_n}). Unset by default so local dev needs no extra setup, but
# set this before deploying anywhere public -- unauthenticated, these routes let any visitor
# drain the shared daily model quota. When set, callers must send a matching X-API-Key header.
ANALYZE_API_KEY=

# Comma-separated list of extra origins allowed to call the API (beyond localhost:5173/4173).
ALLOWED_ORIGINS=

# How long a fetched race program stays cached in memory, in seconds (default: 300).
CACHE_TTL_SECONDS=300
